<Window x:Class="AntiTrendForecast.Directive.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AntiTrendForecast.Directive"
        mc:Ignorable="d"
        Title="Anti-Trend Forecast Engine - Market Fatigue Dashboard" 
        Height="600" Width="600"
        Background="#F5F5F7">

    <Grid x:Name="RootGrid" Margin="32">
        <Grid.Resources>
            <local:InverseBooleanConverter x:Key="InverseBooleanConverter" />
            <local:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
            
            <Style TargetType="TextBlock" x:Key="TitleStyle">
                <Setter Property="FontSize" Value="24"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="#1D1D1F"/>
            </Style>

            <Style TargetType="TextBlock" x:Key="SubtitleStyle">
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#86868B"/>
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="📉 Anti-Trend Forecast Engine"
                   Style="{StaticResource TitleStyle}"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,24"/>

        <!-- Search Input -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBox x:Name="KeywordInput"
                      Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                      Padding="8"
                      FontSize="14"
                      VerticalContentAlignment="Center"
                      Width="350"
                      Margin="0,0,12,0"/>
            
            <Button x:Name="AnalyzeButton"
                    Content="Analyze"
                    Padding="16,8"
                    Background="Black"
                    Foreground="White"
                    FontWeight="Bold"
                    Cursor="Hand"
                    IsEnabled="{Binding IsAnalyzing, Converter={StaticResource InverseBooleanConverter}}"
                    Click="OnAnalyzeClicked"/>
        </StackPanel>

        <!-- Results Area -->
        <StackPanel Grid.Row="2" Margin="0,32,0,0">
            <TextBlock x:Name="StatusText"
                       Text="{Binding StatusMessage}"
                       Style="{StaticResource SubtitleStyle}"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,0,0,24"/>

            <!-- Saturation Result -->
            <StackPanel Visibility="{Binding SaturationLevel, Converter={StaticResource StringToVisibilityConverter}}"
                        HorizontalAlignment="Center">
                
                <TextBlock Text="Market Analysis Overview" 
                           Style="{StaticResource SubtitleStyle}" 
                           HorizontalAlignment="Center"
                           FontSize="14"/>

                <!-- Metrics Grid -->
                <UniformGrid Rows="1" Columns="2" Margin="0,15,0,0" Width="420">
                    <Border Background="White" CornerRadius="8" Padding="15" Margin="5" BorderBrush="#DDD" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="FATIGUE" Foreground="#888" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Text="{Binding SaturationScore}" Foreground="#E74C3C" FontSize="28" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <Border Background="White" CornerRadius="8" Padding="15" Margin="5" BorderBrush="#DDD" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="PIVOT DRIFT" Foreground="#888" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Text="{Binding PivotScore}" Foreground="#3498DB" FontSize="28" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <TextBlock Text="{Binding SaturationLevel}" 
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#1D1D1F"
                           HorizontalAlignment="Center"
                           Margin="0,15,0,5"/>

                <ProgressBar Value="{Binding SaturationScore}" 
                              Maximum="100" 
                              Width="410" 
                              Height="8"
                              Margin="0,5,0,15"
                              Foreground="#0071E3"
                              Background="#E5E5E7"
                              BorderThickness="0"/>

                <!-- Pivot Insight -->
                <Border Background="#1D1D1F" CornerRadius="10" Padding="20" Width="410">
                    <StackPanel>
                        <TextBlock Text="PIVOT INTELLIGENCE" Foreground="#888" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding HistoricalTrend}" Foreground="White" FontSize="15" FontWeight="Medium" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Loading Indicator -->
            <Grid Visibility="{Binding IsAnalyzing, Converter={StaticResource StringToVisibilityConverter}}"
                  Margin="0,20,0,0" HorizontalAlignment="Center">
                <TextBlock Text="⚙️ Analysis in progress..." FontWeight="Bold"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
