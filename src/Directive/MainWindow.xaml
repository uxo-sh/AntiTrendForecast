<Window x:Class="AntiTrendForecast.Directive.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AntiTrendForecast.Directive.ViewModels"
        xmlns:ctrls="clr-namespace:AntiTrendForecast.Directive.Controls"
        xmlns:conv="clr-namespace:AntiTrendForecast.Directive.Converters"
        mc:Ignorable="d"
        x:Name="RootWindow"
        Title="Anti-Trend Forecast Engine" Height="650" Width="1000"
        Background="#0A0A0C" WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <conv:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        
        <!-- Modern ScrollBar Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Sidebar: Recent Analyses -->
        <Border Grid.Column="0" Background="#111114" BorderBrush="#1A1A1D" BorderThickness="0,0,1,0">
            <Grid Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="RECENT ANALYSES" 
                           Foreground="#55555A" 
                           FontSize="10" 
                           FontWeight="Bold" 
                           Margin="0,0,0,15"/>

                <ListBox Grid.Row="1" 
                         ItemsSource="{Binding RecentKeywords}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding}" 
                                    Command="{Binding DataContext.SelectKeywordCommand, ElementName=RootWindow}"
                                    CommandParameter="{Binding}"
                                    HorizontalContentAlignment="Left"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="#A0A0A5"
                                    Padding="10,8"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                                                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="#1A1A1D"/>
                                                            <Setter Property="Foreground" Value="#00F2FF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Column="1" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header & Search -->
            <StackPanel Grid.Row="0" Margin="0,0,0,25">
                <TextBlock Text="ANTI-TREND FORECAST" Foreground="#00F2FF" FontSize="26" FontWeight="Black"/>
                <TextBlock Text="Detect market fatigue and pivot points before they happen." Foreground="#66666E" FontSize="12" Margin="0,4,0,20"/>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBox Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" 
                             Height="45" Padding="15,0" VerticalContentAlignment="Center"
                             Background="#151518" Foreground="White" BorderBrush="#33333E" BorderThickness="1"
                             FontSize="16" SelectionBrush="#00F2FF">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>

                    <Button Grid.Column="1" Command="{Binding AnalyzeCommand}" 
                            Content="ANALYZE" Width="120" Margin="10,0,0,0"
                            Background="#00F2FF" Foreground="Black" FontWeight="Bold"
                            IsEnabled="{Binding IsAnalyzing, Converter={StaticResource InverseBooleanConverter}}"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- Metrics Grid -->
            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,30">
                <!-- Fatigue Score Card -->
                <Border Background="#151518" CornerRadius="8" Padding="15" Margin="0,0,8,8">
                    <StackPanel>
                        <TextBlock Text="MARKET FATIGUE" Foreground="#66666E" FontSize="9" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding SaturationScore, StringFormat={}{0:N1}%}" Foreground="White" FontSize="28" FontWeight="Light"/>
                        <ProgressBar Value="{Binding SaturationScore}" Height="3" Background="#111114" Foreground="#FF4B2B" BorderThickness="0" Margin="0,10,0,5"/>
                    </StackPanel>
                </Border>

                <!-- Pivot Drift Card -->
                <Border Background="#151518" CornerRadius="8" Padding="15" Margin="0,0,8,8">
                    <StackPanel>
                        <TextBlock Text="PIVOT DRIFT" Foreground="#66666E" FontSize="9" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding PivotScore, StringFormat={}{0:+0.0;-0.0;0}}" Foreground="#00FF88" FontSize="28" FontWeight="Light"/>
                        <TextBlock Text="{Binding HistoricalTrend}" Foreground="#44444A" FontSize="10" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Confidence Card -->
                <Border Background="#151518" CornerRadius="8" Padding="15" Margin="0,0,8,8">
                    <StackPanel>
                        <TextBlock Text="CONFIDENCE" Foreground="#66666E" FontSize="9" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding ConfidenceScore, StringFormat={}{0}%}" Foreground="#FFD700" FontSize="28" FontWeight="Light"/>
                        <ProgressBar Value="{Binding ConfidenceScore}" Height="3" Background="#111114" Foreground="#FFD700" BorderThickness="0" Margin="0,10,0,5"/>
                    </StackPanel>
                </Border>

                <!-- Source Card -->
                <Border Background="#151518" CornerRadius="8" Padding="15" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="DATA ORIGIN" Foreground="#66666E" FontSize="9" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock Text="MULTI" Foreground="#A0A0FF" FontSize="20" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding Source}" Foreground="#44444A" FontSize="8" TextWrapping="Wrap" MaxHeight="40"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Status Indicator & Chart -->
            <Border Grid.Row="2" Background="#151518" CornerRadius="8" Padding="25">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="FATIGUE VERDICT" Foreground="#66666E" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding SaturationLevel}" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
                    </StackPanel>

                    <!-- Trend Chart Control -->
                    <ctrls:TrendChart Grid.Row="1" Points="{Binding TrendHistoryPoints}"/>
                </Grid>
            </Border>

            <!-- Bottom Status Footer -->
            <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Foreground="#44444A" FontSize="11" Margin="0,15,0,0"/>
        </Grid>

        <!-- Loading Overlay -->
        <Border Grid.ColumnSpan="2" Background="#CC0A0A0C" Visibility="{Binding IsAnalyzing, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="SCANNING MARKET PULSE..." Foreground="#00F2FF" FontSize="18" FontWeight="Bold"/>
                <ProgressBar IsIndeterminate="True" Width="200" Height="2" Background="Transparent" Foreground="#00F2FF" BorderThickness="0" Margin="0,15,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
